      ],
      "familyId": "bxm-fixed-stat-001",
      "cognitiveLevel": "reproduccion",
      "stream": "authored",
      "stem": "Se tienen las calificaciones de 7 estudiantes: $68, 72, 75, 80, 85, 90, 94$. ¿Cuál es el valor de la mediana de este conjunto de datos?",
      "options": [
        {
          "id": "A",
          "text": "$80$"
        },
        {
          "id": "B",
          "text": "$80.57$",
          "rationale": "Calculó la media aritmética en lugar de la mediana."
        },
        {
          "id": "C",
          "text": "$75$",
          "rationale": "Tomó el primer cuartil aproximado."
        },
        {
          "id": "D",
          "text": "$85$",
          "rationale": "Tomó el tercer cuartil."
        }
      ],
      "correctOptionId": "A",
      "requiresVisual": false,
      "solution": [
        "Los datos ya están ordenados en forma ascendente: $68, 72, 75, 80, 85, 90, 94$.",
        "Al ser $n = 7$ (número impar), la mediana corresponde exactamente al dato central en la posición $\\frac{7+1}{2} = 4$.",
        "El cuarto dato es $80$."
      ],
      "provenance": {
        "source": "content/bxm-mvp-learning/authored-items-pack.json#bxm-authored-v1-stat-001",
        "status": "authored_computationally_checked"
      },
