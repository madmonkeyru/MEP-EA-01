  "questions": [
    {
      "id": "bxm-authored-v1-geo-001",
      "version": "1.1.0",
      "programId": "bxm",
      "subjectId": "matematica",
      "domainId": "geometry",
      "evidenceId": "bxm/matematica/02-2026/geometry/A1.2",
      "conceptIds": [
        "mep-geo-circunferencia-01"
      ],
      "familyId": "bxm-iso-geo-circ-canon",
      "cognitiveLevel": "reproduccion",
      "stream": "authored",
      "stem": "Considere una circunferencia cuyo centro es el punto $(3, -4)$ y cuya medida del radio es $5$. ¿Cuál es la ecuación canónica de dicha circunferencia?",
      "options": [
        {
          "id": "A",
          "text": "$(x - 3)^2 + (y + 4)^2 = 25$"
        },
        {
          "id": "B",
          "text": "$(x + 3)^2 + (y - 4)^2 = 25$",
          "rationale": "Invirtió los signos de las coordenadas del centro al sustituir en $(x-h)^2 + (y-k)^2 = r^2$."
        },
        {
          "id": "C",
          "text": "$(x - 3)^2 + (y + 4)^2 = 5$",
          "rationale": "Olvidó elevar el radio al cuadrado en el miembro derecho ($r=5$, pero puso $5$ en vez de $25$)."
        },
        {
          "id": "D",
          "text": "$(x + 3)^2 + (y - 4)^2 = 5$",
          "rationale": "Invirtió los signos del centro y además no elevó el radio al cuadrado."
        }
      ],
      "correctOptionId": "A",
      "requiresVisual": false,
      "solution": [
        "La forma canónica de una circunferencia con centro $(h, k)$ y radio $r$ es $(x - h)^2 + (y - k)^2 = r^2$.",
        "Sustituyendo $h = 3$, $k = -4$ y $r = 5$:",
        "$(x - 3)^2 + (y - (-4))^2 = 5^2$",
        "$(x - 3)^2 + (y + 4)^2 = 25$."
      ],
      "provenance": {
        "source": "content/bxm-mvp-learning/authored-items-pack.json#bxm-authored-v1-geo-001",
        "status": "authored_computationally_checked"
      },
      "publication": {
        "status": "draft"
      }
    },
    {
      "id": "bxm-authored-v1-func-001",
      "version": "1.1.0",
      "programId": "bxm",
      "subjectId": "matematica",
      "domainId": "functions",
      "evidenceId": "bxm/matematica/02-2026/functions/A2.3",
      "conceptIds": [
        "mep-alg-funcion-lineal-03"
      ],
      "familyId": "bxm-fixed-func-001",
      "cognitiveLevel": "reproduccion",
      "stream": "authored",
      "stem": "¿Cuál es la pendiente de la recta que pasa por los puntos $P(2, -3)$ y $Q(6, 5)$?",
      "options": [
        {
          "id": "A",
          "text": "$2$"
        },
        {
          "id": "B",
          "text": "$\\frac{1}{2}$",
          "rationale": "Invirtió la fórmula calculando $\\Delta x / \\Delta y$ en vez de $\\Delta y / \\Delta x$."
        },
        {
          "id": "C",
          "text": "$-2$",
          "rationale": "Error de signos en la diferencia de las ordenadas."
        },
        {
          "id": "D",
          "text": "$4$",
          "rationale": "Calculó únicamente la diferencia de las abscisas."
        }
      ],
      "correctOptionId": "A",
      "requiresVisual": false,
      "solution": [
        "La fórmula de la pendiente es $m = \\frac{y_2 - y_1}{x_2 - x_1}$.",
        "Sustituyendo los puntos: $m = \\frac{5 - (-3)}{6 - 2} = \\frac{5 + 3}{4} = \\frac{8}{4} = 2$."
      ],
      "provenance": {
        "source": "content/bxm-mvp-learning/authored-items-pack.json#bxm-authored-v1-func-001",
        "status": "authored_computationally_checked"
      },
      "publication": {
        "status": "draft"
      }
    },
    {
      "id": "bxm-authored-v1-stat-001",
      "version": "1.1.0",
      "programId": "bxm",
      "subjectId": "matematica",
      "domainId": "statistics",
      "evidenceId": "bxm/matematica/02-2026/statistics/A1.2",
      "conceptIds": [
