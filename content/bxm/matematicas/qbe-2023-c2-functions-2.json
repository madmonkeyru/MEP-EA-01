      "code": "item-qbe-2023-c2-functions-2-q52",
      "set_id": "qbe-2023-c2-functions-2",
      "area": "Relaciones y Álgebra",
      "area_id": "functions",
      "topic": "functions",
      "stem": "Analice la siguiente parábola para responder las preguntas 52 y 53;\nAnalice las siguientes proposiciones referidas a la función f;\nI. c>0.\nII. a<0.\nDe ellas son verdaderas",
      "options": {
        "A": "ambas",
        "B": "ninguna",
        "C": "solo la I",
        "D": "solo la II"
      },
