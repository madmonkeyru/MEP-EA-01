    {
      "id": 10356,
      "code": "item-qbe-2024-c1-functions-1-q02",
      "set_id": "qbe-2024-c1-functions-1",
      "area": "Relaciones y Álgebra",
      "area_id": "functions",
      "topic": "functions",
      "stem": "Analice las siguientes relaciones T y R:\nI. Sea A= {-2, 2} y B= {0} y T es la relación de A → B tal que T={ (x,y): y=x^2-4 }\nII. Sea C ={-1, 2) y D={0,3) y R la relación de C → D tal que R { (x,y): y=x-2 }\nDe ellas son funciones:",
      "options": {
        "A": "ninguna",
        "B": "solo la R",
        "C": "solo la T"
      },
      "correct_answer": "C",
      "solution_steps": [
        "T envía -2 y 2 a cero. R(-1)=-3 no pertenece al codominio {0,3}. Solo T es función."
      ],
      "visual_spec": null,
      "calculator_allowed": true,
      "program_applicability": [
