    {
      "id": 10357,
      "code": "item-qbe-2024-c1-functions-1-q03",
      "set_id": "qbe-2024-c1-functions-1",
      "area": "Relaciones y Álgebra",
      "area_id": "functions",
      "topic": "functions",
      "stem": "Analice las funciones g y h. Considere a ℝ el universo para los dominios y codominios de estas funciones:\nh: [-6,5] → [-8,3]\ng: ]2, +∞[ → ]0. +∞[\nSi se define una función f, tal que, su dominio esté constituido por la intersección del dominio de h con el complemento del codominio de g, entonces el dominio de la función f es",
      "options": {
        "A": "]0,5]",
        "B": "[-6,0]",
        "C": "[-6,2]"
      },
      "correct_answer": "B",
      "solution_steps": [
        "El complemento del codominio de g=(0,∞) es (-∞,0]. Intersecarlo con [-6,5] da [-6,0]."
      ],
      "visual_spec": null,
      "calculator_allowed": true,
      "program_applicability": [
