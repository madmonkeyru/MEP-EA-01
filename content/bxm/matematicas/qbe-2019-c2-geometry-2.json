    {
      "id": 10595,
      "code": "item-qbe-2019-c2-geometry-2-q03",
      "set_id": "qbe-2019-c2-geometry-2",
      "area": "Geometría",
      "area_id": "geometry",
      "topic": "geometry",
      "stem": "Considere las siguientes proposiciones:\nI- El punto (0,3) se encuentra en el interior de la circunferencia definida por x^2+y^2=8\nII- El punto (1,1) se ubica al exterior de la circunferencia definida por (x+1)^2+(y+1)^2=4\nDe ellas son verdaderas",
      "options": {
        "A": "ambas",
        "B": "ninguna",
        "C": "solo la I",
        "D": "solo la II"
      },
      "correct_answer": "D",
      "solution_steps": [
        "En I, 0²+3²=9>8, por lo que el punto no es interior. En II, (1+1)²+(1+1)²=8>4 y el punto es exterior. Solo II."
      ],
      "visual_spec": null,
      "calculator_allowed": true,
      "program_applicability": [
        "BXM"
      ],
      "source_question_id": "bxm-raw-2019-c2-geometry-2-q03",
