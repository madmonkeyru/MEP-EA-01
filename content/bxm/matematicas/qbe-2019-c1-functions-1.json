      "code": "item-qbe-2019-c1-functions-1-q14",
      "set_id": "qbe-2019-c1-functions-1",
      "area": "Relaciones y Álgebra",
      "area_id": "functions",
      "topic": "functions",
      "stem": "Se estampa sobre una tela una figura con forma de rombo con un área de 40 cm^2. La diagonal menor mide 2 cm menos que la diagonal mayor. ¿Cuánto mide la diagonal menor? (Recordar que el área de un rombo es A=Dd/2)",
      "options": {
        "A": "8",
        "B": "9",
        "C": "11",
        "D": "12"
      },
      "correct_answer": "A",
      "solution_steps": [
        "Si d es la diagonal menor, d(d+2)/2=40. d²+2d-80=(d+10)(d-8)=0 y la solución positiva es 8."
      ],
      "visual_spec": null,
      "calculator_allowed": true,
