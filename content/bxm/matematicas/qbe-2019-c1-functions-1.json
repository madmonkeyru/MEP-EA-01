      "code": "item-qbe-2019-c1-functions-1-q01",
      "set_id": "qbe-2019-c1-functions-1",
      "area": "Relaciones y Álgebra",
      "area_id": "functions",
      "topic": "functions",
      "stem": "Considere las siguientes proposiciones referidas a la función f: D→{0} siendo f(x)=(x^2-1)/x\nI (-1) ∊ D\nII {1} ⊆ D\nIII D={-1} ⋃ {0} ⋃ {1}\n¿Cuáles son verdaderas?",
      "options": {
        "A": "solo la I",
        "B": "solo la II",
        "C": "solo la III",
        "D": "solo la I y la II"
      },
      "correct_answer": "D",
      "solution_steps": [
        "El codominio es {0}, así que x²-1=0 y x≠0: D={-1,1}. I y II son verdaderas; III incluye indebidamente cero."
      ],
      "visual_spec": null,
      "calculator_allowed": true,
