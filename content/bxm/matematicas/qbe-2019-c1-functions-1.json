    {
      "id": 10538,
      "code": "item-qbe-2019-c1-functions-1-q04",
      "set_id": "qbe-2019-c1-functions-1",
      "area": "Relaciones y Álgebra",
      "area_id": "functions",
      "topic": "functions",
      "stem": "Considere las siguientes proposiciones referentes a las relaciones T y J\nI- Sean A={1,4} y B={0,3) y T la relación A→B con T={(x,y): y=x-1}\nII- Sean D={0,2} y E={0,3) y J la relación D→E con J={(x,y): y=x^2+1}\n¿Cuál o cuáles relaciones son función?",
      "options": {
        "A": "ambas",
        "B": "ninguna",
        "C": "solo la I",
        "D": "solo la II"
      },
      "correct_answer": "C",
      "solution_steps": [
        "T asigna 1→0 y 4→3 dentro de B y es función. J(0)=1 no pertenece a E={0,3}; J no define una función D→E. Solo I."
      ],
      "visual_spec": null,
      "calculator_allowed": true,
      "program_applicability": [
