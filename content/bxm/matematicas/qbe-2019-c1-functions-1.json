      "code": "item-qbe-2019-c1-functions-1-q06",
      "set_id": "qbe-2019-c1-functions-1",
      "area": "Relaciones y Álgebra",
      "area_id": "functions",
      "topic": "functions",
      "stem": "La inversa de la función f(x)=x/2+4 se encuentra dada por f⁻¹(x)=ax+b. Entonces se cumple que:",
      "options": {
        "A": "$a = 8 y b = -2$",
        "B": "$a = -8 y b = 2$",
        "C": "$a = -2 y b = 8$",
        "D": "$a = 2 y b = -8$"
      },
      "correct_answer": "D",
      "solution_steps": [
        "y=x/2+4 implica x=2y-8. La inversa es 2x-8: a=2,b=-8."
      ],
      "visual_spec": null,
