{
  "name": "mep-ea-digital",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "npm run test:poc && npm run test:foundation",
    "test:flows": "node scripts/run-browser-suite.mjs",
    "test:a11y": "node scripts/audit-core.mjs",
    "test:learning": "node scripts/run-browser-suite.mjs --learning-only",
    "audit:performance": "node scripts/run-browser-suite.mjs --performance",
    "audit:bundle": "node scripts/measure-bundle.mjs",
    "dev:mobile": "npm run start --workspace @mep-ea/mobile",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.packages.json --noEmit && npm run typecheck --workspace @mep-ea/mobile",
    "test:foundation": "vitest run --config vitest.foundation.config.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "build:mobile": "npm run export --workspace @mep-ea/mobile",
    "test:poc": "vitest run",
    "test:foundation:browser": "node scripts/verify-foundation.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "lighthouse": "^12.8.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
